# Installed to /etc/logrotate.d/zeek-otx by install-so2.sh.
#
# The hourly cron job appends to this file forever. On a healthy sensor that is
# nothing; on one that is failing every run it is a traceback an hour, which
# eventually fills /var.
/var/log/zeek-otx.log {
	weekly
	rotate 4
	compress
	delaycompress
	missingok
	notifempty
	create 0640 root adm
}
